# copy to .env and adjust
DOMAIN=opossum.example.com
# the same certificate is used for port 443 (implicit TLS) and port 80 (RFC 2817 upgrade)
CERT_FILE=/etc/letsencrypt/live/opossum.example.com/fullchain.pem
KEY_FILE=/etc/letsencrypt/live/opossum.example.com/privkey.pem
# preset for the optional proxy service (catdog | selfxss | rangexss | session)
OPOSSUM_PRESET=catdog
